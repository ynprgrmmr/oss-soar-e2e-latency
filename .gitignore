# ---- Secrets / credentials (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
!*.pub.example
.oci/
oci_api_key*
**/secrets/

# ---- Terraform ----
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally committed (provider pinning).

# ---- RouterOS exports (may contain passwords / public IPs) ----
*.backup
*-export.rsc
!**/routeros/*.rsc

# ---- Experiments ----
# Raw logs ARE committed after sanitization. Unsanitized dumps stay local.
experiments/**/raw/_unsanitized/
experiments/**/raw/**/alerts-full*.json
experiments/**/*.pcap
experiments/**/*.pcapng

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
